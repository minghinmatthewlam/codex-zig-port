# elvish completion for codex-zig
edit:completion:arg-completer[codex-zig] = {|@words|
    var candidates = ['exec' 'e' 'review' 'login' 'logout' 'mcp' 'plugin' 'mcp-server' 'app-server' 'remote-control' 'app' 'completion' 'update' 'doctor' 'sandbox' 'debug' 'execpolicy' 'apply' 'a' 'resume' 'fork' 'cloud' 'responses-api-proxy' 'stdio-to-uds' 'exec-server' 'features' 'help' '--help' '-h' '--version' '-V' '--profile' '-p' '--profile-v2' '--cd' '-C' '--add-dir' '--config' '-c' '--strict-config' '--model' '-m' '--image' '-i' '--enable' '--disable' '--oss' '--local-provider' '--ask-for-approval' '-a' '--approval-policy' '--sandbox' '-s' '--dangerously-bypass-approvals-and-sandbox' '--yolo' '--dangerously-bypass-hook-trust' '--search' '--remote' '--remote-auth-token-env' '--remote-control' '--remote-control-bind' '--no-alt-screen']
    if (> (count $words) 1) {
        if (== $words[1] completion) {
            put 'bash' 'elvish' 'fish' 'powershell' 'zsh'
            return
        }
    }
    put $@candidates
}
